# ==============================================================================
# closeVDS Backend Environment Configuration Template
# SERVER-SIDE ONLY — NEVER EXPOSE SECRETS TO FRONTEND OR BROWSER BUNDLES
# ==============================================================================

# Runtime Environment
NODE_ENV=development
HOST=127.0.0.1
PORT=4000

# Security & CORS
CORS_ORIGIN=http://localhost:3000
BODY_LIMIT_BYTES=1048576

# Logging
LOG_LEVEL=info

# Rate Limiting Defaults
RATE_LIMIT_MAX=100
RATE_LIMIT_TIME_WINDOW_MS=60000
AUTH_RATE_LIMIT_MAX=20
AUTH_RATE_LIMIT_WINDOW_MS=60000

# Safety Controls
KILL_SWITCH_ACTIVE=false

# Authentication & Session Secrets (Replace with high-entropy 64-char keys in production)
JWT_SECRET=super_secret_jwt_signing_key_for_closevds_backend_production_use_only
JWT_EXPIRES_IN=7d
COOKIE_SECRET=super_secret_cookie_signing_key_for_closevds_backend_production_use

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://user:password@localhost:5432/closevds
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# AI / LLM Provider Configuration (Server-Side Only)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Telephony & Voice (Twilio)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Email Outreach (Resend)
RESEND_API_KEY=
RESEND_WEBHOOK_SECRET=

# WhatsApp Business Cloud API (Meta)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# n8n Automation Orchestrator
N8N_WEBHOOK_SECRET=super_secret_n8n_hmac_webhook_signing_key
N8N_BASE_URL=http://localhost:5678

# closeBDS External Lead Sourcing
CLOSEBDS_API_KEY=
CLOSEBDS_BASE_URL=
